# -----------------------------------------------------------------------------
# Base Django
# Copiez ce fichier vers backend/.env puis gardez uniquement le bloc email voulu.
# -----------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Option 1: Envoi réel avec Gmail
# Utilisez un mot de passe d'application Gmail.
# -----------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=votre_adresse@gmail.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre_adresse@gmail.com
# EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# -----------------------------------------------------------------------------
# Option 2: Test sécurisé avec Mailtrap
# Remplacez par vos identifiants Mailtrap.
# -----------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=sandbox@mailtrap.io
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=votre_user_mailtrap
# EMAIL_HOST_PASSWORD=votre_password_mailtrap
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# -----------------------------------------------------------------------------
# Option 3: Développement local sans vrai envoi
# Le mail s'affiche dans le terminal Django.
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@gestions-notes.local
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
